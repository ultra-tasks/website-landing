{
  "name": "ultra-tasks-website",
  "version": "0.1.0",
  "private": true,
  "description": "The public website for Ultra Tasks.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node --check script.js && node scripts/check.mjs",
    "test": "node --test \"scripts/*.test.mjs\"",
    "preview": "node scripts/serve.mjs dist",
    "release:update": "node scripts/update-release.mjs",
    "release:render": "node scripts/update-release.mjs --render-only",
    "release:verify": "node scripts/verify-release.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
